# All optional: LiftLab runs with these defaults and no secrets.
LIFTLAB_ALPHA=0.05          # significance level
LIFTLAB_SEED=42             # default RNG seed for the demo scenario
LIFTLAB_THREADS=0           # C++ engine threads (0 = all cores)
LIFTLAB_DB=:memory:         # DuckDB location; a file path persists experiments
